// Ressources Windows de CoopLink : icône, métadonnées de version, manifeste (admin + DPI).
#include <winver.h>

1 ICON "../../images/icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Loic HUON"
            VALUE "FileDescription", "CoopLink - partage de jeu et reseau local virtuel"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "cooplink"
            VALUE "LegalCopyright", "Copyright (c) 2026 Loic HUON. Tous droits reserves."
            VALUE "OriginalFilename", "cooplink.exe"
            VALUE "ProductName", "CoopLink"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 1200
    END
END
