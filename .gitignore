# CoopLink .gitignore

# Rust build output
/target/
**/*.rs.bk
*.pdb

# Dependencies sources & vendor
/sources/

# Artefacts de build
/dist/
/build/

# Encodeur vidéo téléchargé (100 Mo, non versionné — voir installer/BUILD.md)
/installer/redist/ffmpeg.exe

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# Cargo lock can be tracked or ignored (typically tracked for binaries)
